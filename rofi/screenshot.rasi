configuration {
    show-icons: false;
}

@import "colors.rasi"

* {
    font: "JetBrains Mono Nerd Font 12";
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    fullscreen:       false;
    width:            520px;
    border-radius:    16px;
    border:           2px solid;
    border-color:     @selected;
    background-color: @background-solid;
    padding:          20px;
}

mainbox {
    spacing:          12px;
    background-color: transparent;
    orientation:      vertical;
    children:         [ "inputbar", "message" ];
}

inputbar {
    spacing:          10px;
    padding:          10px 14px;
    border-radius:    10px;
    background-color: @background-alt;
    text-color:       @foreground;
    children:         [ "prompt", "entry" ];
}

prompt {
    enabled:          true;
    background-color: transparent;
    text-color:       @selected;
    font:             "JetBrains Mono Nerd Font Bold 12";
}

entry {
    background-color:  transparent;
    text-color:        inherit;
    cursor:            text;
    placeholder:       "Filename (leave blank for timestamp)...";
    placeholder-color: @dim;
}

message {
    padding:          4px 8px;
    border-radius:    8px;
    background-color: transparent;
    text-color:       @dim;
}

textbox {
    background-color: transparent;
    text-color:       @dim;
    font:             "JetBrains Mono Nerd Font 10";
    horizontal-align: 0.5;
}

listview {
    enabled: false;
    lines: 0;
}
