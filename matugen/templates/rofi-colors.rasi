* {
    background:          {{colors.surface.default.hex}}00;
    background-solid:    {{colors.surface.default.hex}};
    background-alt:      {{colors.surface_container_high.default.hex}};
    foreground:          {{colors.on_surface.default.hex}};
    selected:            {{colors.primary.default.hex}};
    selected-text-color: {{colors.on_primary.default.hex}};
    active:              {{colors.tertiary.default.hex}};
    urgent:              {{colors.error.default.hex}};
    dim:                 {{colors.outline.default.hex}};
}
