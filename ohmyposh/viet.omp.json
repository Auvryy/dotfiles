{
  "Created": "Phunt_Vieg_",
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "bg": "#12140d",
    "fg": "#e3e3d7",
    "black": "#12140d",
    "white": "#e3e3d7",
    "blue": "#bbcf82",
    "main-blue": "#bbcf82",
    "lavender": "#c3caa9",
    "cyan": "#a1d0c6",
    "teal": "#a1d0c6",
    "green": "#3d4c0e",
    "purple": "#c3caa9",
    "red": "#ffb4ab",
    "pink": "#204e47",
    "yellow": "#434931",
    "orange": "#a1d0c6",
    "select": "#909284"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "p:select",
          "style": "plain",
          "template": "╭─",
          "type": "text"
        },
        {
          "background": "p:main-blue",
          "foreground": "p:black",
          "leading_diamond": "",
          "style": "diamond",
          "template": "{{ if ne (.Segments.Contains \"Python\") true }}  {{ .UserName }} {{ end }}",
          "trailing_diamond": "",
          "type": "session"
        },
        {
          "background": "p:main-blue",
          "foreground": "p:black",
          "leading_diamond": "",
          "properties": {
            "display_mode": "environment",
            "home_enabled": true,
            "folder_name_fallback": false
          },
          "style": "diamond",
          "template": "  ({{ .Venv }}) ",
          "trailing_diamond": "",
          "type": "python"
        },
        {
          "background": "p:blue",
          "foreground": "p:black",
          "properties": {
            "style": "full"
          },
          "style": "diamond",
          "template": "  {{ .Path }} ",
          "trailing_diamond": "",
          "type": "path"
        },
        {
          "background": "p:cyan",
          "foreground": "p:black",
          "properties": {
            "branch_icon": "",
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "diamond",
          "template": "  {{ .UpstreamIcon }} {{ .HEAD }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "trailing_diamond": "",
          "type": "git"
        },
        {
          "background": "p:lavender",
          "foreground": "p:black",
          "properties": {
            "time_format": "15:04"
          },
          "style": "diamond",
          "template": "{{ if ne (.Segments.Contains \"Git\") true }}  {{ .CurrentDate | date .Format }} {{ end }}",
          "trailing_diamond": "",
          "type": "time"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "p:select",
          "style": "plain",
          "template": "╰─<p:cyan>❯</>",
          "type": "text"
        }
      ]
    }
  ],
  "transient_prompt": {
    "template": "<p:cyan>❯</><p:blue>❯</><p:lavender>❯</> "
  },
  "final_space": true,
  "version": 8
}
